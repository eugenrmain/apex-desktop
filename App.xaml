<Application x:Class="Apex.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <!-- Shared controls use the same cool palette as the custom glass widgets. -->
      <!-- WinUI resolves the control font through theme dictionaries, so Geist must be overridden there. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default"><FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist.ttf#Geist</FontFamily></ResourceDictionary>
        <ResourceDictionary x:Key="Light"><FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist.ttf#Geist</FontFamily></ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast"><FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist.ttf#Geist</FontFamily></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Color x:Key="SystemAccentColor">#67D8FF</Color>
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#67D8FF" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#202733" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2B3442" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#171D27" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#EDF1F7" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#EDF1F7" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#EDF1F7" />
      <SolidColorBrush x:Key="ButtonBackground" Color="#D0181D27" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#ED272F3B" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#ED121720" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#356F7C90" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#607A8B9E" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5065768C" />
      <SolidColorBrush x:Key="ButtonForeground" Color="#DEEAFF" />
      <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B0131720" />
      <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#C01D222C" />
      <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#90152239" />
      <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#9CACC7" />
      <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#456C92C7" />
      <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#606C92C7" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#B0131720" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#D01D232E" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F00D1118" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#B0131720" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#D01D232E" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F0101B33" />
      <SolidColorBrush x:Key="ContentDialogBackground" Color="#F0101B33" />
      <SolidColorBrush x:Key="FlyoutBackground" Color="#F0101B33" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
